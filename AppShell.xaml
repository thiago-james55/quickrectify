<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QuickRectifyMaui2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QuickRectifyMaui2"
    FlyoutBehavior="Flyout"
    FlyoutHeaderBehavior="CollapseOnScroll"
    Title="QuickRectifyMaui2">

    <Shell.FlyoutHeader>
        <StackLayout Padding="5" BackgroundColor="White">
            <Image Source="logo.png" HeightRequest="100" />
        </StackLayout>
    </Shell.FlyoutHeader>
    
    <FlyoutItem Title="Home" Icon="home.png">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Home2" Icon="home.png">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <StackLayout Padding="5">
            <Label HorizontalTextAlignment="Center">Created by Thiago Gonçalves Souza</Label>
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>
